<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  Example unattend.xml — MDT standalone USB deployment

  Full workflow guide:  docs/UNATTEND.md   (start there if you've never
                                            edited an unattend before)

  Usage in brief:
    1. Copy this file (don't edit in place — keep the example clean).
    2. Optionally change TimeZone, ComputerName.
    3. Link to your task sequence — two ways:
         a. MDT Workbench: right-click task sequence → Properties → OS Info
            tab → Edit Unattend.xml. Import this file in Windows SIM. MDT
            stages it to C:\Windows\Panther\unattend.xml automatically.
         b. File-drop: save as
            DeploymentShare\Control\<TaskSequenceID>\unattend.xml — MDT
            auto-discovers it on the next Update-MDTDeploymentShare.

  What this template does:
    - Sets US English locale (change in the international-core component)
    - Sets timezone to UTC (change in specialize + oobeSystem if needed)
    - Joins the Workgroup workgroup (standalone; not domain-joined)
    - Skips OOBE pages (EULA, OEM reg, online account, wireless, privacy)
    - Creates one no-password local admin (LocalAdmin) used only to let
      MDT's LTIBootstrap.vbs run. Set a password or disable post-deploy
      per your hardening baseline.
    - Configures AutoLogon (one-shot, no password) for unattended first boot
    - Sets ComputerName ("*" = Windows random; %SerialNumber% = service tag)
    - Calls LTIBootstrap.vbs (Order 1) so MDT continues the task sequence
      after first logon, then first-login.ps1 (Order 2) for HKCU tweaks
    - STIG account hardening (rename + disable built-in accounts) is handled
      by task sequence steps injected by Initialize-MDTDeploymentShare.ps1,
      not here — keeps it visible and logged in the MDT task sequence.

  Additional accounts:
    Create tech/user accounts in the MDT task sequence (State Restore group)
    via net user / PowerShell steps — not here. That keeps passwords out of
    the XML and centralises account management in CustomSettings.ini.

  Note on SkipMachineOOBE / SkipUserOOBE:
    Microsoft marks these as deprecated and warns of unintended effects, but
    they are included here because many production deployments rely on them
    for full OOBE suppression. Remove them if you observe unexpected behavior.

  Note on first-login.ps1:
    The script must be present at C:\Windows\Setup\Scripts\first-login.ps1
    on the deployed machine for Order 2 to do anything. Options:
      a. Bake it into the WIM before importing to MDT (dism /image offline copy).
      b. Add it as an MDT Application that copies the file during State Restore,
         before the first reboot that triggers FirstLogonCommands.
    If absent, Order 2 fails silently and Order 1 (LTIBootstrap.vbs) is unaffected.

  Adjusting for x86 / ARM64:
    Replace processorArchitecture="amd64" with "x86" or "arm64" everywhere.

  Microsoft's reference:
    https://learn.microsoft.com/en-us/windows-hardware/customize/desktop/unattend/
  ============================================================================
-->
<unattend xmlns="urn:schemas-microsoft-com:unattend">

  <!-- ====================================================================
       generalize pass — runs during sysprep /generalize on the reference image
       SkipRearm=1 prevents the activation grace-period timer from resetting,
       which is required when sysprepping an already-activated image.
       ==================================================================== -->
  <settings pass="generalize">
    <component name="Microsoft-Windows-Security-SPP"
               processorArchitecture="amd64"
               publicKeyToken="31bf3856ad364e35"
               language="neutral"
               versionScope="nonSxS"
               xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State">
      <SkipRearm>1</SkipRearm>
    </component>
  </settings>

  <!-- ====================================================================
       specialize pass — runs after Sysprep, before first user login
       ==================================================================== -->
  <settings pass="specialize">
    <component name="Microsoft-Windows-Shell-Setup"
               processorArchitecture="amd64"
               publicKeyToken="31bf3856ad364e35"
               language="neutral"
               versionScope="nonSxS"
               xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State">
      <!-- "*" = Windows generates a random name (documented behavior).
           "%SerialNumber%" = use the machine's service tag / serial.
           Fixed string = same name on every machine (test builds only).
           ComputerName is limited to 15 characters. -->
      <ComputerName>*</ComputerName>
      <!-- Change if you need a different timezone. Run `tzutil /l` to list
           valid names. UTC is a safe default for enterprise deployments. -->
      <TimeZone>Coordinated Universal Time</TimeZone>
    </component>

    <!-- Standalone deployment — not domain-joined. Remove this component
         or replace JoinWorkgroup with a JoinDomain block if needed. -->
    <component name="Microsoft-Windows-UnattendedJoin"
               processorArchitecture="amd64"
               publicKeyToken="31bf3856ad364e35"
               language="neutral"
               versionScope="nonSxS"
               xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State">
      <Identification>
        <JoinWorkgroup>Workgroup</JoinWorkgroup>
      </Identification>
    </component>
  </settings>

  <!-- ====================================================================
       oobeSystem pass — runs OOBE on first boot
       ==================================================================== -->
  <settings pass="oobeSystem">

    <component name="Microsoft-Windows-International-Core"
               processorArchitecture="amd64"
               publicKeyToken="31bf3856ad364e35"
               language="neutral"
               versionScope="nonSxS">
      <InputLocale>en-US</InputLocale>
      <SystemLocale>en-US</SystemLocale>
      <UILanguage>en-US</UILanguage>
      <UserLocale>en-US</UserLocale>
    </component>

    <component name="Microsoft-Windows-Shell-Setup"
               processorArchitecture="amd64"
               publicKeyToken="31bf3856ad364e35"
               language="neutral"
               versionScope="nonSxS"
               xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State">

      <OOBE>
        <HideEULAPage>true</HideEULAPage>
        <HideOEMRegistrationScreen>true</HideOEMRegistrationScreen>
        <HideOnlineAccountScreens>true</HideOnlineAccountScreens>
        <HideWirelessSetupInOOBE>true</HideWirelessSetupInOOBE>
        <NetworkLocation>Work</NetworkLocation>
        <ProtectYourPC>3</ProtectYourPC>
        <!-- Deprecated by Microsoft but included for full OOBE suppression.
             Remove if you observe unexpected behavior on the target hardware. -->
        <SkipMachineOOBE>true</SkipMachineOOBE>
        <SkipUserOOBE>true</SkipUserOOBE>
      </OOBE>

      <TimeZone>Coordinated Universal Time</TimeZone>

      <!-- LocalAdmin exists solely to give MDT's LTIBootstrap.vbs a session
           to run under. No password — deployment-only account. Harden or
           disable it post-deploy per your STIG baseline. Additional tech/user
           accounts belong in the MDT task sequence (State Restore), not here. -->
      <UserAccounts>
        <LocalAccounts>
          <LocalAccount wcm:action="add">
            <Name>LocalAdmin</Name>
            <Group>Administrators</Group>
            <DisplayName>Local Admin</DisplayName>
            <Password>
              <Value></Value>
              <PlainText>true</PlainText>
            </Password>
          </LocalAccount>
        </LocalAccounts>
      </UserAccounts>

      <!-- AutoLogon: one-shot, no password. Required for MDT's LTIBootstrap.vbs
           to run unattended. LogonCount=1 reverts to the lock screen after. -->
      <AutoLogon>
        <Username>LocalAdmin</Username>
        <Enabled>true</Enabled>
        <LogonCount>1</LogonCount>
      </AutoLogon>

      <!-- Order 1 MUST be LTIBootstrap.vbs — MDT continues the State Restore
           group (BitLocker, STIG account hardening, etc.) from here.
           Order 2 runs first-login.ps1 for HKCU tweaks (NumLock, Explorer
           settings, debloat). STIG account renames and the built-in admin
           disable are task sequence steps, not FirstLogonCommands. -->
      <FirstLogonCommands>
        <SynchronousCommand wcm:action="add">
          <Order>1</Order>
          <Description>Lite Touch new OS</Description>
          <CommandLine>wscript.exe %SystemDrive%\LTIBootstrap.vbs</CommandLine>
        </SynchronousCommand>
        <SynchronousCommand wcm:action="add">
          <Order>2</Order>
          <Description>Apply per-user HKCU tweaks</Description>
          <CommandLine>powershell.exe -NoProfile -ExecutionPolicy Bypass -File C:\Windows\Setup\Scripts\first-login.ps1</CommandLine>
        </SynchronousCommand>
      </FirstLogonCommands>

    </component>
  </settings>
</unattend>
