# WinPE build artifacts (builder default is C:\WinPE_Build; the
# path is only relevant on Windows, but we keep relative patterns
# in case someone runs the builder with -WorkDir inside the repo)
/WinPE_Build/
mount/

# Third-party binaries staged for builder input (CCTK, drivers, etc.).
# Dell CCTK in particular is NOT redistributable — never commit it.
/vendor/
/cctk-source/
cctk.exe
hapint*.sys
hapint*.inf
*.wim
*.esd
*.iso

# Secrets / runtime staging files (only the *.example.* templates are
# tracked; the real files carry plaintext passwords/PIN and must never
# be committed).
accounts.csv
bitlocker-pin.txt
dell-config.cctk
npp-installer.exe

# Deploy logs
deploy_*.log
*.log

# Diskpart working files
deploy_diskpart.txt

# PowerShell / editor artifacts
*.ps1xml.bak
*.bak
*.tmp
*.swp
*~

# IDE
.vs/
.vscode/
.idea/
*.suo
*.user

# OS
Thumbs.db
Desktop.ini
.DS_Store

# Test output
TestResults/
coverage/

# MDT deployment share artifacts (created outside repo by default but belt-and-suspenders)
MDTDeploymentShare/
*DeploymentShare/
LiteTouchMedia_x64.iso
