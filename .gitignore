# WinPE build artifacts (builder default is C:\WinPE_Build; the
# path is only relevant on Windows, but we keep relative patterns
# in case someone runs the builder with -WorkDir inside the repo)
/WinPE_Build/
mount/

# Third-party binaries staged for builder input (CCTK, drivers, etc.).
# Dell CCTK in particular is NOT redistributable — never commit it.
/vendor/
/cctk-source/
cctk.exe
# DCC 4.0+ DCH API DLLs that ship alongside cctk.exe (build_boot_wim.ps1
# refuses to embed a CCTK tree missing these — they're equally non-
# redistributable Dell binaries).
dchapi64.dll
dchbas64.dll
BIOSIntf.dll
# Legacy HAPI driver (pre-DCC 4.0 only; kept for older trees).
hapint*.sys
hapint*.inf
*.wim
*.esd
*.iso

# Deploy logs
deploy_*.log
*.log

# Diskpart working files
deploy_diskpart.txt

# PowerShell / editor artifacts
*.ps1xml.bak
*.bak
*.tmp
*.swp
*~

# IDE
.vs/
.vscode/
.idea/
*.suo
*.user

# OS
Thumbs.db
Desktop.ini
.DS_Store

# Test output
TestResults/
coverage/
