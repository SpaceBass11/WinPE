# Canonical line endings stored in the repo.
# - PowerShell: LF in the repo; PS 5.1+ parses both, avoids churn on cross-platform devs.
# - CMD: CRLF — startnet.cmd must be CRLF for some WinPE builds.
# - Windows config / ini / reg files: CRLF for downstream tools that expect it.

* text=auto eol=lf

*.ps1     text eol=lf
*.psd1    text eol=lf
*.psm1    text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.json    text eol=lf
*.sh      text eol=lf

*.cmd     text eol=crlf
*.bat     text eol=crlf
*.ini     text eol=crlf
*.reg     text eol=crlf

# Mark binaries so Git doesn't touch them.
*.wim     binary
*.esd     binary
*.iso     binary
*.png     binary
*.jpg     binary
*.ico     binary
